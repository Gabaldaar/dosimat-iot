rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Perfil y Equipos de Usuarios
    match /usuarios/{uid} {
      allow read, write: if isAuthenticated();
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Roles y Administradores
    match /roles/{document} {
      allow read, write: if isAuthenticated();
    }

    match /administradores/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Colección de Equipos y todas sus Subcolecciones (estado, config, programas, comandos, logs)
    match /equipos/{chipId} {
      allow read, write: if isAuthenticated();
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
